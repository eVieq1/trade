<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Выбор месяца -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/btnPrevMonth"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="◀" />

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="Июнь 2026"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#FFFFFF" />

            <Button
                android:id="@+id/btnNextMonth"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="▶" />

        </LinearLayout>

        <!-- Календарь -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Заголовки -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0,1,2,3,4,5,6">

                    <TableRow>
                        <TextView android:text="ПН" android:padding="8dp" android:gravity="center" android:textStyle="bold" android:background="#E0E0E0"/>
                        <TextView android:text="ВТ" android:padding="8dp" android:gravity="center" android:textStyle="bold" android:background="#E0E0E0"/>
                        <TextView android:text="СР" android:padding="8dp" android:gravity="center" android:textStyle="bold" android:background="#E0E0E0"/>
                        <TextView android:text="ЧТ" android:padding="8dp" android:gravity="center" android:textStyle="bold" android:background="#E0E0E0"/>
                        <TextView android:text="ПТ" android:padding="8dp" android:gravity="center" android:textStyle="bold" android:background="#E0E0E0"/>
                        <TextView android:text="СБ" android:padding="8dp" android:gravity="center" android:textStyle="bold" android:background="#E0E0E0"/>
                        <TextView android:text="ВС" android:padding="8dp" android:gravity="center" android:textStyle="bold" android:background="#E0E0E0"/>
                    </TableRow>

                </TableLayout>

                <!-- Сетка дней -->
                <TableLayout
                    android:id="@+id/tableSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0,1,2,3,4,5,6" />

            </LinearLayout>
        </ScrollView>

        <!-- Информация о выбранном дне -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Понедельник - 1 июня"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Директор магазина (Я)"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnEditShift"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:visibility="gone"
                    android:contentDescription="Редактировать" />

                <ImageView
                    android:id="@+id/btnSaveToServer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:visibility="gone"
                    android:contentDescription="Сохранить на сервер" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvEmployeeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Немыкин Владислав Андреевич"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShiftTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Часы работы дневные"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvUpdateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Последнее обновление: Сегодня"
                android:textSize="10sp"
                android:textColor="#999999"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>